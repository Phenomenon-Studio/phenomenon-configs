{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Phenomenon Studio dependency policy. Projects: { \"extends\": [\"github>Phenomenon-Studio/phenomenon-configs//renovate/default\"] }",
    "extends": ["config:recommended", ":semanticCommits", ":dependencyDashboard"],
    "labels": ["dependencies"],
    "schedule": ["before 6am on monday"],
    "timezone": "Europe/Kyiv",
    "minimumReleaseAge": "3 days",
    "internalChecksFilter": "strict",
    "prConcurrentLimit": 10,
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["before 6am on the first day of the month"]
    },
    "vulnerabilityAlerts": {
        "labels": ["security"],
        "schedule": ["at any time"],
        "minimumReleaseAge": null
    },
    "packageRules": [
        {
            "description": "Next.js stack moves together",
            "matchPackageNames": [
                "next",
                "@next/**",
                "eslint-config-next",
                "react",
                "react-dom",
                "@types/react",
                "@types/react-dom"
            ],
            "groupName": "next and react"
        },
        {
            "description": "Vite stack moves together",
            "matchPackageNames": ["vite", "@vitejs/**", "@rolldown/**", "rollup-plugin-visualizer", "vite-plugin-html"],
            "groupName": "vite"
        },
        {
            "matchPackageNames": ["@tanstack/**"],
            "groupName": "tanstack"
        },
        {
            "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "tw-animate-css"],
            "groupName": "tailwind"
        },
        {
            "description": "Lint/format tooling and plugins. The configs themselves are rendered by the template and arrive with template updates",
            "matchPackageNames": [
                "eslint",
                "@eslint/**",
                "@eslint-react/**",
                "eslint-plugin-*",
                "eslint-config-*",
                "@next/eslint-plugin-next",
                "@tanstack/eslint-plugin-*",
                "@stylistic/**",
                "typescript-eslint",
                "globals",
                "prettier",
                "prettier-plugin-*",
                "@ianvs/prettier-plugin-sort-imports",
                "stylelint",
                "stylelint-config-*",
                "typescript",
                "@commitlint/**",
                "husky",
                "knip"
            ],
            "groupName": "lint and format tooling"
        },
        {
            "description": "typescript-eslint caps TypeScript (<6.1 today); TS majors/minors go through the platform first",
            "matchPackageNames": ["typescript"],
            "matchUpdateTypes": ["major", "minor"],
            "dependencyDashboardApproval": true
        },
        {
            "description": "Node.js (.nvmrc, engines) and pnpm (packageManager) follow the platform catalog",
            "matchPackageNames": ["node", "pnpm"],
            "groupName": "runtime"
        },
        {
            "matchDepTypes": ["action"],
            "groupName": "github actions",
            "pinDigests": false
        }
    ]
}
