{
    "name": "example-vite-css-modules",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    },
    "scripts": {
        "dev:vite": "vite --host",
        "dev:vite:scan": "vite --host --mode scan",
        "dev:tsc": "tsc --build --watch",
        "dev": "pnpm run --parallel \"/^dev:(vite|tsc)$/\"",
        "dev:scan": "pnpm run --parallel dev:vite:scan dev:tsc",
        "build": "vite build",
        "preview": "vite preview --host",
        "tsc": "tsc --build",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"**/*.{js,ts,tsx,cjs,mjs}\"",
        "knip": "knip",
        "lint:stylelint": "stylelint --cache -q \"**/*.css\"",
        "lint:fmt": "prettier --check \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "lint": "pnpm run \"/^lint:.*/\"",
        "fix:fmt": "prettier --write \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "prepare": "husky"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    },
    "dependencies": {
        "@base-ui/react": "1.8.0",
        "@casl/ability": "7.0.1",
        "@casl/react": "7.0.1",
        "@react-hookz/web": "26.1.0",
        "@tanstack/react-form": "1.33.5",
        "@tanstack/react-query": "5.104.0",
        "@tanstack/react-router": "1.170.41",
        "clsx": "2.1.1",
        "ky": "2.1.0",
        "lucide-react": "1.49.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-error-boundary": "6.1.6",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@babel/core": "8.0.6",
        "@commitlint/cli": "21.2.3",
        "@phenomenon-studio/commitlint-config": "1.0.0",
        "@phenomenon-studio/eslint-config": "1.0.0",
        "@phenomenon-studio/prettier-config": "1.0.0",
        "@phenomenon-studio/stylelint-config": "1.0.0",
        "@phenomenon-studio/tsconfig": "1.0.0",
        "@rolldown/plugin-babel": "0.2.4",
        "@tanstack/react-query-devtools": "5.104.0",
        "@tanstack/react-router-devtools": "1.167.2",
        "@tanstack/router-plugin": "1.168.42",
        "@types/babel__core": "7.20.5",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "10.11.0",
        "husky": "9.1.7",
        "knip": "6.39.0",
        "msw": "3.0.1",
        "prettier": "3.9.9",
        "rollup-plugin-visualizer": "7.1.1",
        "stylelint": "17.16.0",
        "typescript": "6.0.3",
        "vite": "8.3.2",
        "vite-plugin-html": "3.2.2"
    }
}
