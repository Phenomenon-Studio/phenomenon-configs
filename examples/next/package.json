{
    "name": "example-next",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=24",
        "pnpm": ">=11",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    },
    "scripts": {
        "dev": "next dev --turbopack --experimental-https",
        "dev:scan": "APP_MODE=scan next dev --turbopack --experimental-https",
        "build": "next build",
        "build:analyze": "ANALYZE=true next build",
        "start": "next start -p 4173",
        "tsc": "next typegen && tsc",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives .",
        "lint:stylelint": "stylelint --cache -q \"**/*.css\"",
        "lint:fmt": "prettier --check \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "lint": "pnpm run \"/^lint:.*/\"",
        "fix:fmt": "prettier --write \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "prepare": "husky"
    },
    "browserslist": [
        "> 0.3%",
        "not dead",
        "Firefox >= 113",
        "Chrome >= 111",
        "Edge >= 111",
        "Safari >= 16.4",
        "ios_saf >= 16.4"
    ],
    "dependencies": {
        "@react-hookz/web": "26.1.0",
        "@t3-oss/env-nextjs": "0.13.11",
        "@tanstack/react-query": "5.104.0",
        "clsx": "2.1.1",
        "cookies-next": "6.1.1",
        "ky": "2.1.0",
        "next": "16.4.0",
        "nextjs-toploader": "3.9.17",
        "nuqs": "2.10.2",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-error-boundary": "6.1.6",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.3",
        "@next/bundle-analyzer": "16.4.0",
        "@phenomenon-studio/commitlint-config": "1.0.0",
        "@phenomenon-studio/eslint-config": "1.0.0",
        "@phenomenon-studio/prettier-config": "1.0.0",
        "@phenomenon-studio/stylelint-config": "1.0.0",
        "@phenomenon-studio/tsconfig": "1.0.0",
        "@svgr/webpack": "8.1.0",
        "@tanstack/react-query-devtools": "5.104.0",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "autoprefixer": "10.6.1",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "10.11.0",
        "husky": "9.1.7",
        "postcss": "8.5.29",
        "prettier": "3.9.9",
        "stylelint": "17.16.0",
        "typescript": "6.0.3"
    }
}
