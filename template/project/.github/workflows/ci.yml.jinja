name: CI

on:
    push:
        branches: [main]
    pull_request:
    # Started by the template update job on its PR branch.
    workflow_dispatch:

concurrency:
    group: {{ '${{ github.workflow }}-${{ github.ref }}' }}
    cancel-in-progress: true

jobs:
    ci:
        # Pipeline lives in phenomenon-configs; fixes on the same major arrive automatically.
        uses: Phenomenon-Studio/phenomenon-configs/.github/workflows/node-ci.yml@v1
{%- if stack == 'next' %}
        with:
            # Public env vars validated at build time (src/lib/env.ts). Replace with your project's values.
            build-env: |
                NEXT_PUBLIC_API_URL=https://example.com
{%- endif %}
