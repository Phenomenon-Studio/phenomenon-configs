{% from 'template/versions.jinja' import versions, dep with context -%}
{
    "name": "{{ project_name }}",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@{{ versions.runtime.pnpm }}",
    "engines": {
        "node": ">={{ versions.runtime.node }}",
        "pnpm": ">={{ versions.runtime.pnpm.split('.')[0] }}",
        "npm": "please-use-pnpm",
        "yarn": "please-use-pnpm"
    },
    "scripts": {
{%- if stack == 'vite' %}
        "dev:vite": "vite --host",
        "dev:vite:scan": "vite --host --mode scan",
        "dev:tsc": "tsc --build --watch",
        "dev": "pnpm run --parallel \"/^dev:(vite|tsc)$/\"",
        "dev:scan": "pnpm run --parallel dev:vite:scan dev:tsc",
        "build": "vite build",
        "preview": "vite preview --host",
        "tsc": "tsc --build",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives \"**/*.{js,ts,tsx,cjs,mjs}\"",
        "knip": "knip",
{%- elif stack == 'next' %}
        "dev": "next dev --turbopack --experimental-https",
        "dev:scan": "APP_MODE=scan next dev --turbopack --experimental-https",
        "build": "next build",
        "build:analyze": "ANALYZE=true next build",
        "start": "next start -p 4173",
        "tsc": "next typegen && tsc",
        "lint:eslint": "eslint --cache --max-warnings 0 --report-unused-disable-directives .",
{%- endif %}
        "lint:stylelint": "stylelint --cache -q \"**/*.css\"",
        "lint:fmt": "prettier --check \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "lint": "pnpm run \"/^lint:.*/\"",
        "fix:fmt": "prettier --write \"**/*.{js,ts,tsx,json,html,css,cjs,mjs}\"",
        "prepare": "husky"
    },
{%- if stack == 'vite' %}
    "msw": {
        "workerDirectory": [
            "public"
        ]
    },
    "dependencies": {
        {{ dep('@base-ui/react') }}
        {{ dep('@casl/ability') }}
        {{ dep('@casl/react') }}
        {{ dep('@react-hookz/web') }}
        {{ dep('@tanstack/react-form') }}
        {{ dep('@tanstack/react-query') }}
        {{ dep('@tanstack/react-router') }}
{%- if styling == 'tailwind' %}
        {{ dep('class-variance-authority') }}
        {{ dep('cn') }}
{%- else %}
        {{ dep('clsx') }}
{%- endif %}
        {{ dep('ky') }}
        {{ dep('lucide-react') }}
        {{ dep('react') }}
        {{ dep('react-dom') }}
        {{ dep('react-error-boundary') }}
        {{ dep('zod', last=True) }}
    },
    "devDependencies": {
        {{ dep('@babel/core') }}
        {{ dep('@commitlint/cli') }}
        {{ dep('@phenomenon-studio/commitlint-config') }}
        {{ dep('@phenomenon-studio/eslint-config') }}
        {{ dep('@phenomenon-studio/prettier-config') }}
        {{ dep('@phenomenon-studio/stylelint-config') }}
        {{ dep('@phenomenon-studio/tsconfig') }}
        {{ dep('@rolldown/plugin-babel') }}
{%- if styling == 'tailwind' %}
        {{ dep('@tailwindcss/vite') }}
{%- endif %}
        {{ dep('@tanstack/react-query-devtools') }}
        {{ dep('@tanstack/react-router-devtools') }}
        {{ dep('@tanstack/router-plugin') }}
        {{ dep('@types/babel__core') }}
        {{ dep('@types/node') }}
        {{ dep('@types/react') }}
        {{ dep('@types/react-dom') }}
        {{ dep('@vitejs/plugin-react') }}
        {{ dep('babel-plugin-react-compiler') }}
        {{ dep('eslint') }}
        {{ dep('husky') }}
        {{ dep('knip') }}
        {{ dep('msw') }}
        {{ dep('prettier') }}
        {{ dep('rollup-plugin-visualizer') }}
{%- if styling == 'tailwind' %}
        {{ dep('shadcn') }}
{%- endif %}
        {{ dep('stylelint') }}
{%- if styling == 'tailwind' %}
        {{ dep('tailwindcss') }}
        {{ dep('tw-animate-css') }}
{%- endif %}
        {{ dep('typescript') }}
        {{ dep('vite') }}
        {{ dep('vite-plugin-html', last=True) }}
    }
{%- elif stack == 'next' %}
    "browserslist": [
        "> 0.3%",
        "not dead",
        "Firefox >= 113",
        "Chrome >= 111",
        "Edge >= 111",
        "Safari >= 16.4",
        "ios_saf >= 16.4"
    ],
    "dependencies": {
        {{ dep('@react-hookz/web') }}
        {{ dep('@t3-oss/env-nextjs') }}
        {{ dep('@tanstack/react-query') }}
        {{ dep('clsx') }}
        {{ dep('cookies-next') }}
        {{ dep('ky') }}
        {{ dep('next') }}
        {{ dep('nextjs-toploader') }}
        {{ dep('nuqs') }}
        {{ dep('react') }}
        {{ dep('react-dom') }}
        {{ dep('react-error-boundary') }}
        {{ dep('zod', last=True) }}
    },
    "devDependencies": {
        {{ dep('@commitlint/cli') }}
        {{ dep('@next/bundle-analyzer') }}
        {{ dep('@phenomenon-studio/commitlint-config') }}
        {{ dep('@phenomenon-studio/eslint-config') }}
        {{ dep('@phenomenon-studio/prettier-config') }}
        {{ dep('@phenomenon-studio/stylelint-config') }}
        {{ dep('@phenomenon-studio/tsconfig') }}
        {{ dep('@svgr/webpack') }}
        {{ dep('@tanstack/react-query-devtools') }}
        {{ dep('@types/node') }}
        {{ dep('@types/react') }}
        {{ dep('@types/react-dom') }}
        {{ dep('autoprefixer') }}
        {{ dep('babel-plugin-react-compiler') }}
        {{ dep('eslint') }}
        {{ dep('husky') }}
        {{ dep('postcss') }}
        {{ dep('prettier') }}
        {{ dep('stylelint') }}
        {{ dep('typescript', last=True) }}
    }
{%- endif %}
}
