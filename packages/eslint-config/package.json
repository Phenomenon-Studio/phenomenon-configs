{
    "name": "@phenomenon-studio/eslint-config",
    "version": "1.0.0",
    "description": "Shared ESLint flat configs for Phenomenon Studio projects",
    "license": "UNLICENSED",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Phenomenon-Studio/phenomenon-configs.git",
        "directory": "packages/eslint-config"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "files": [
        "src"
    ],
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.js"
        },
        "./base": {
            "types": "./src/config.d.ts",
            "default": "./src/base.js"
        },
        "./react": {
            "types": "./src/config.d.ts",
            "default": "./src/react.js"
        },
        "./tanstack-query": {
            "types": "./src/config.d.ts",
            "default": "./src/tanstack-query.js"
        },
        "./tanstack-router": {
            "types": "./src/config.d.ts",
            "default": "./src/tanstack-router.js"
        },
        "./vite": {
            "types": "./src/config.d.ts",
            "default": "./src/vite.js"
        },
        "./next": {
            "types": "./src/config.d.ts",
            "default": "./src/next.js"
        }
    },
    "scripts": {
        "test": "node test/smoke.js"
    },
    "dependencies": {
        "@eslint-react/eslint-plugin": "5.26.1",
        "@eslint/js": "10.0.1",
        "@next/eslint-plugin-next": "16.4.0",
        "@stylistic/eslint-plugin": "5.10.0",
        "@tanstack/eslint-plugin-query": "5.104.2",
        "@tanstack/eslint-plugin-router": "1.162.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-jsx-a11y-x": "0.2.0",
        "eslint-plugin-prettier": "5.5.6",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "typescript-eslint": "8.71.1"
    },
    "devDependencies": {
        "eslint": "10.12.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3"
    },
    "peerDependencies": {
        "eslint": "^10.0.0",
        "prettier": "^3.0.0",
        "typescript": ">=6.0.0 <6.1.0"
    }
}
